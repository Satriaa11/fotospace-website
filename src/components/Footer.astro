---
import { Image } from 'astro:assets'
import { SITE } from '../config'
import logo from '../assets/logo.png'

const year = new Date().getFullYear()
---

<footer class="border-t border-border/60 bg-sunken">
  <div class="container-site grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-4">
    <div class="sm:col-span-2 lg:col-span-1 space-y-3">
      <a href="/" class="flex items-center gap-2 font-semibold">
        <Image src={logo} alt="" width={20} height={20} class="h-5 w-5 rounded-md" />
        <span>{SITE.name}</span>
      </a>
      <p class="max-w-xs text-sm leading-[1.65] text-muted-foreground">{SITE.tagline}</p>
    </div>

    <nav aria-label="Produk" class="space-y-3 text-sm">
      <p class="font-medium text-foreground">Produk</p>
      <ul class="space-y-2 text-muted-foreground">
        <li><a class="transition-colors hover:text-foreground" href="/#fitur">Fitur</a></li>
        <li><a class="transition-colors hover:text-foreground" href="/#harga">Harga</a></li>
        <li><a class="transition-colors hover:text-foreground" href="/unduh">Unduh</a></li>
      </ul>
    </nav>

    <nav aria-label="Bantuan" class="space-y-3 text-sm">
      <p class="font-medium text-foreground">Bantuan</p>
      <ul class="space-y-2 text-muted-foreground">
        <li><a class="transition-colors hover:text-foreground" href="/panduan">Panduan</a></li>
        <li><a class="transition-colors hover:text-foreground" href="/changelog">Changelog</a></li>
        <li>
          <a class="transition-colors hover:text-foreground" href="mailto:satria.fotospace@gmail.com"
            >Kontak</a
          >
        </li>
      </ul>
    </nav>

    <nav aria-label="Akun" class="space-y-3 text-sm">
      <p class="font-medium text-foreground">Akun</p>
      <ul class="space-y-2 text-muted-foreground">
        <li><a class="transition-colors hover:text-foreground" href="/login">Masuk</a></li>
        <li><a class="transition-colors hover:text-foreground" href="/register">Daftar</a></li>
        <li><a class="transition-colors hover:text-foreground" href="/dashboard">Dashboard</a></li>
      </ul>
    </nav>
  </div>

  <div class="border-t border-border/40 py-4">
    <p class="container-site text-center text-xs text-muted-foreground">
      &copy; {year} {SITE.name}. FotoYu adalah merek dagang milik pemiliknya masing-masing.
    </p>
  </div>
</footer>
