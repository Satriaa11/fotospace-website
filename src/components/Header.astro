---
import { Image } from 'astro:assets'
import { SITE } from '../config'
import logo from '../assets/logo.png'
import UserNav from './UserNav'
import ThemeToggle from './ThemeToggle'

const path = Astro.url.pathname
const onHome = path === '/'

const links = [
  { href: onHome ? '#fitur' : '/#fitur', label: 'Fitur', match: null },
  { href: onHome ? '#harga' : '/#harga', label: 'Harga', match: null },
  { href: '/unduh', label: 'Unduh', match: '/unduh' },
  { href: '/panduan', label: 'Panduan', match: '/panduan' },
]
---

<header class="sticky top-0 z-50 border-b border-border/60 bg-background/85 backdrop-blur">
  <div class="container-site flex h-14 items-center gap-3">
    <a href="/" class="flex shrink-0 items-center gap-2 font-semibold tracking-tight">
      <Image src={logo} alt="" width={24} height={24} class="h-6 w-6 rounded-md" />
      <span>{SITE.name}</span>
    </a>

    <nav class="ml-4 hidden items-center gap-0.5 text-sm md:flex" aria-label="Utama">
      {
        links.map((link) => (
          <a
            class:list={[
              'nav-link',
              link.match && path.startsWith(link.match) && 'nav-link-active',
            ]}
            href={link.href}
            aria-current={link.match && path.startsWith(link.match) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-1">
      <ThemeToggle client:load />
      <UserNav client:idle />

      <details class="relative md:hidden">
        <summary
          class="nav-link inline-flex h-9 cursor-pointer list-none items-center px-3 text-sm [&::-webkit-details-marker]:hidden"
        >
          Menu
        </summary>
        <div
          class="absolute right-0 z-50 mt-2 w-44 rounded-[10px] border border-border bg-surface p-1.5 shadow-[var(--fs-enlarger)]"
        >
          {
            links.map((link) => (
              <a
                class="nav-link block w-full text-sm"
                href={link.href}
                aria-current={link.match && path.startsWith(link.match) ? 'page' : undefined}
              >
                {link.label}
              </a>
            ))
          }
          <a class="nav-link block w-full text-sm sm:hidden" href="/login">Masuk</a>
        </div>
      </details>
    </div>
  </div>
</header>
