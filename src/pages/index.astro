---
import Base from '../layouts/Base.astro'
import Hero from '../components/Hero.astro'
import Problem from '../components/Problem.astro'
import Features from '../components/Features.astro'
import HowItWorks from '../components/HowItWorks.astro'
import Pricing from '../components/Pricing.astro'
import Faq from '../components/Faq.astro'
import FinalCta from '../components/FinalCta.astro'
import { FAQ } from '../data/faq'
import { SITE } from '../config'

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
}
---

<Base
  title="Foto Space — Upload ribuan foto event ke FotoYu, otomatis"
  description="Aplikasi desktop untuk fotografer event: upload batch ribuan foto & video ke FotoYu secara paralel dengan kompresi cerdas, resume anti-gagal, dan laporan CSV/PDF."
>
  <Hero />
  <Problem />
  <Features />
  <HowItWorks />
  <Pricing />
  <Faq />
  <FinalCta />

  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'Foto Space',
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Windows 10, Windows 11, Linux',
      url: `${SITE.url}/`,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'IDR' },
    })}
  />
</Base>
