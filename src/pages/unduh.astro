---
import Base from '../layouts/Base.astro'
import DownloadView from '../components/DownloadView'
import { RELEASES } from '../config'
import { fetchLatestRelease } from '../lib/releases'

const release = await fetchLatestRelease()
const version = release?.tag_name ?? 'versi terbaru'
---

<Base
  title="Unduh Foto Space"
  description={`Unduh Foto Space ${version} untuk Windows, macOS, dan Linux. Lisensi dibeli dari dashboard setelah instalasi.`}
>
  <section class="container-site py-16 sm:py-20">
    <p class="kicker">Unduh</p>
    <h1 class="mt-4 text-balance text-[clamp(2rem,4vw,3rem)] font-semibold leading-[1.1] tracking-[-0.02em]">
      Unduh untuk Windows, macOS, dan Linux
    </h1>
    <p class="body-copy mt-4">
      Satu file installer per sistem. Pembaruan di GitHub otomatis tampil di halaman ini.
      Setelah terpasang, aktivasi lisensi dari dalam aplikasi.
    </p>

    <DownloadView client:load initialRelease={release} />

    <div class="mt-12 max-w-3xl border-t border-border pt-8">
      <h2 class="text-sm font-semibold">Catatan instalasi</h2>
      <ul class="mt-4 space-y-2.5 text-sm leading-[1.65] text-muted-foreground">
        <li>
          <strong class="font-medium text-foreground">Windows 10/11:</strong> jalankan installer
          .exe. Jika SmartScreen muncul, pilih “More info” lalu “Run anyway”. Foto Space belum
          memakai sertifikat berbayar.
        </li>
        <li>
          <strong class="font-medium text-foreground">macOS:</strong> buka file .dmg, tarik Foto
          Space ke folder Applications. Apple Silicon pakai build arm64; Mac Intel pakai build x64.
        </li>
        <li>
          <strong class="font-medium text-foreground">Linux (AppImage):</strong> beri izin eksekusi
          dulu: <code class="font-mono text-[13px]">chmod +x foto-space-*.AppImage</code>, lalu
          jalankan.
        </li>
      </ul>
      <p class="mt-6 text-sm text-muted-foreground">
        Versi lama tersedia di{' '}
        <a
          class="underline decoration-border-strong underline-offset-4 transition-colors duration-150 hover:text-foreground"
          href={`https://github.com/${RELEASES.repo}/releases`}>arsip rilis GitHub</a
        >.
      </p>
    </div>
  </section>
</Base>
